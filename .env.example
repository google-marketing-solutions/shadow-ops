# ==============================================================================
# ShadowOps Platform Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Web Server Configuration
# ------------------------------------------------------------------------------
# Port for the Go backend API and static web server to listen on
PORT=8080

# Network interface bind address (e.g. :8080 or 0.0.0.0:8080)
BIND_ADDR=:8080

# Directory for SQLite database (shadowops.db) and persistent storage
DATA_DIR=./data

# Directory containing built Angular frontend files for direct web UI serving
STATIC_DIR=./frontend/dist/frontend/browser

# Enable/disable ShadowOps platform features
SHADOWOPS_ENABLED=true

# ------------------------------------------------------------------------------
# Host Agent (Docker Manager) Configuration
# ------------------------------------------------------------------------------
# Full URL to reach the Node.js Host Agent (supports http:// and https://)
# Examples: http://127.0.0.1:8081, http://host-agent:8081, https://host-agent.internal:8443
HOST_AGENT_URL=http://127.0.0.1:8081

# Host Agent listen port (used when starting host-agent)
# PORT=8081

# ------------------------------------------------------------------------------
# Workspace Container Settings
# ------------------------------------------------------------------------------
# Docker image name tag used for launched workspace containers
WORKSPACE_IMAGE_NAME=shadowops-workspace-agent:dev

# Default URL opened inside newly launched workspace browser sessions
DEFAULT_TARGET_URL=https://accounts.google.com/ServiceLogin/signinchooser

# ------------------------------------------------------------------------------
# Google Cloud & Kubernetes (GKE) Configuration
# ------------------------------------------------------------------------------
# Kubernetes namespace for workspace agent pods (default: 'default')
K8S_NAMESPACE=default

# Container image for GKE workspace pods (Artifact Registry / GCR)
WORKSPACE_POD_IMAGE=shadowops-workspace-agent:latest

# Target port for workspace agent containers in pods (default: 8765)
WORKSPACE_AGENT_PORT=8765

# Resource requests & limits for workspace pods
POD_CPU_REQUEST=200m
POD_MEMORY_REQUEST=512Mi
# POD_CPU_LIMIT=1000m
# POD_MEMORY_LIMIT=2Gi

# Maximum number of concurrent workspace pods in the pool
POD_POOL_LIMIT=10

# GKE Cluster endpoint & base64 CA Cert (used when backend runs on Cloud Run)
# GKE_ENDPOINT=https://34.xxx.xxx.xxx
# GKE_CA_CERT=LS0tLS1CRUdJTi...

# ------------------------------------------------------------------------------
# Gemini AI Configuration (Playwright Script Generation)
# ------------------------------------------------------------------------------
# Gemini Model Name (default: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# API Key for Gemini (leave empty if using GCP Application Default Credentials / IAM)
GEMINI_API_KEY=

# Custom Gemini API endpoint override (optional)
# GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-pro:generateContent
